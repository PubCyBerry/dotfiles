[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    # use n and N to move between diff sections
    navigate = true
    # or light = true, or omit for auto-detection
    dark = true
    side-by-side = true
    # show line numbers
    line-numbers = true

[merge]
    conflictStyle = zdiff3
