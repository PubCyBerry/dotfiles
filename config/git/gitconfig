[core]
    # diff/log 출력에 delta pager 사용
    pager = delta
    # 기본 편집기: neovim (포그라운드 실행)
    editor = nvim -f
    # Windows에서 파일 권한 변경 무시 (NTFS 미지원)
    fileMode = false
    # 체크아웃 시 LF→CRLF, 커밋 시 CRLF→LF 자동 변환
    autocrlf = true
    # 줄바꿈 정규화 기준: OS 네이티브
    eol = native

[interactive]
    # git add -p 등 대화형 모드에서도 delta 컬러 필터 적용
    diffFilter = delta --color-only

[delta]
    # n/N 키로 diff 섹션 이동
    navigate = true
    # 다크 테마 사용
    dark = true
    # 좌우 분할 비교 뷰
    side-by-side = true
    # 줄 번호 표시
    line-numbers = true

[merge]
    # zdiff3: base 원본을 함께 표시해 충돌 컨텍스트 확대
    conflictStyle = zdiff3
