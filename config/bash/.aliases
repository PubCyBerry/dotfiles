# ~/.aliases

# Navigation
alias ..="cd .."
alias ...="cd ../.."
alias ~="cd ~"

# List - eza가 있으면 사용, 없으면 ls fallback
if command -v eza &>/dev/null; then
  alias ls="eza --icons"
  alias ll="eza --icons -lh"
  alias la="eza --icons -lah"
  alias lt="eza --icons -lh --tree --level=2"
else
  alias ls="ls --color=auto"
  alias ll="ls -lhF"
  alias la="ls -lAhF"
fi

# bat - 없으면 cat fallback
if command -v bat &>/dev/null; then
  alias cat="bat"
elif command -v batcat &>/dev/null; then
  alias cat="batcat"
fi

# Git
alias g="git"
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline --graph --decorate"

# Claude
alias ccd="claude --dangerously-skip-permissions"

# Safety
alias cp="cp -i"
alias mv="mv -i"
alias rm="rm -i"
