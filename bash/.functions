# ~/.functions

# 디렉토리 생성 후 이동
mkcd() {
  mkdir -p "$@" && cd "$_"
}

# N단계 위로 이동 (기본값: 1)
up() {
  local count="${1:-1}"
  local path
  path="$(printf '../%.0s' $(seq 1 "$count"))"
  cd "$path" || return
}

# 압축 파일 자동 해제 (확장자 감지)
extract() {
  if [[ -f "$1" ]]; then
    case "$1" in
      *.tar.bz2)  tar xjf "$1"   ;;
      *.tar.gz)   tar xzf "$1"   ;;
      *.tar.xz)   tar xJf "$1"   ;;
      *.tar.zst)  tar --zstd -xf "$1" ;;
      *.bz2)      bunzip2 "$1"   ;;
      *.gz)       gunzip "$1"    ;;
      *.tar)      tar xf "$1"    ;;
      *.tbz2)     tar xjf "$1"   ;;
      *.tgz)      tar xzf "$1"   ;;
      *.zip)      unzip "$1"     ;;
      *.Z)        uncompress "$1";;
      *.7z)       7z x "$1"      ;;
      *.xz)       unxz "$1"      ;;
      *.zst)      zstd -d "$1"   ;;
      *)          echo "'$1' 은 지원되지 않는 형식입니다." ;;
    esac
  else
    echo "'$1' 은 유효한 파일이 아닙니다."
  fi
}

# WSL2 전용: Windows 클립보드 연동
if grep -qi microsoft /proc/version 2>/dev/null; then
  # 클립보드 복사 (echo "text" | clip)
  alias clip="clip.exe"

  # 클립보드 붙여넣기
  paste() {
    powershell.exe -command "Get-Clipboard" | sed 's/\r//'
  }

  # WSL 경로 → Windows 경로 변환
  wpath() {
    wslpath -w "${1:-.}"
  }

  # Windows 경로 → WSL 경로 변환
  upath() {
    wslpath -u "$1"
  }
fi
